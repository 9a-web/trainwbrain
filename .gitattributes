# Normalize line endings: shell scripts and configs must be LF on Linux.
# Windows checkout keeps CRLF for docs/code, but .sh and server configs are LF.
* text=auto eol=lf
*.sh          text eol=lf
*.conf        text eol=lf
*.service     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.png         binary
*.jpg         binary
*.ico         binary
