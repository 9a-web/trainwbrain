# TrainWithBrain — frontend environment (CRA / CRACO)
#
# Copy to `.env` for local development and fill in real values.
# NOTE: CRA inlines every REACT_APP_* variable into the client bundle.
#       Never put secrets (API keys, bot tokens, passwords) in this file —
#       they are visible to every visitor of the built app.

# Base URL of the backend API (no trailing slash).
# WebSocket base is derived from it automatically (http->ws, https->wss).
# Local dev:  http://localhost:8000
# Production: https://api.example.com
REACT_APP_BACKEND_URL=http://localhost:8000

# Dev server socket port (create-react-app / webpack-dev-server).
WDS_SOCKET_PORT=3000

# Optional feature flag: backend health-check polling.
ENABLE_HEALTH_CHECK=false
