# /opt/trainwbrain/frontend/.env.production  (используется при `yarn build`)
#
# CRA ВШИВАЕТ эти значения в бандл на этапе сборки. Секретов здесь быть не должно.
# Тот же домен, что и у фронтенда: API и WebSocket идут на него же
# (api.js сам заменит http -> ws, получится wss://trainwbrain.ru/api/ws).
REACT_APP_BACKEND_URL=https://trainwbrain.ru
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
