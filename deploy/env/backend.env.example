# /opt/trainwbrain/backend/.env   (chmod 600, НЕ коммитить)
#
# Этот файл читает python-dotenv при старте server.py.
# Если рядом лежит .env.local, он загружается с override=true и побеждает.

MONGO_URL="mongodb://127.0.0.1:27017"
DB_NAME="trainwbrain_db"

# Домены фронтенда. Без слэша в конце. Wildcard "*" не используем:
# при allow_credentials=True он запрещён браузерами.
CORS_ORIGINS="https://trainwbrain.ru,https://www.trainwbrain.ru"

# Telegram Mini App — токен бота из BotFather (секрет!)
TELEGRAM_BOT_TOKEN=""

# Google-вход (Emergent Managed Auth) — опционально, можно оставить пустым
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# HTTPS -> true. false удобно только для локальной разработки по http.
COOKIE_SECURE=true

# Backend стоит за nginx -> доверяем X-Forwarded-For от 127.0.0.1
TRUST_PROXY_HEADERS=true

# true ОТКЛЮЧАЕТ проверку TLS к MongoDB. Для локального mongod не нужно.
MONGO_TLS_INSECURE=false

# ---------------------------------------------------------------------------
# ИИ (OpenAI-совместимый эндпоинт). Код делает POST {AI_BASE_URL}/chat/completions
# ---------------------------------------------------------------------------
# Вариант 1 — официальный DeepSeek:
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
# Вариант 2 — RouterAI (если вы уже используете его локально):
# AI_BASE_URL="https://routerai.ru/api/v1"
# AI_MODEL="deepseek/deepseek-v4-flash"

# Vision (фото программ / кардио). Пример — Gemini через OpenAI-совместимый слой.
AI_VISION_BASE_URL=""
AI_VISION_API_KEY=""
AI_VISION_MODEL="gemini-flash-latest"
