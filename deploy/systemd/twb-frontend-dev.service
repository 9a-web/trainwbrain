# /etc/systemd/system/twb-frontend-dev.service
# Dev-сервер фронтенда (CRA/CRACO) на 127.0.0.1:3000.
# Открывается через SSH-туннель (localhost:3000) либо через
# nginx-конфиг deploy/nginx/dev-trainwbrain.conf.

[Unit]
Description=TrainWithBrain frontend dev server (CRA/CRACO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/trainwbrain/frontend
Environment=NODE_ENV=development
Environment=BROWSER=none
Environment=CI=false
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=WDS_SOCKET_PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=4096
ExecStart=/usr/bin/yarn start
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
