MONGO_URL="mongodb://localhost:27017"
DB_NAME="trainwbrain_db"
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# secure-cookie: true на проде (HTTPS), false удобно для http://localhost.
COOKIE_SECURE=true
# =true ОТКЛЮЧАЕТ проверку TLS-сертификата при подключении к MongoDB.
# Включайте только при самоподписанном прокси перед Atlas. По умолчанию false.
MONGO_TLS_INSECURE=false
# =true доверяет заголовку X-Forwarded-For (берётся ПОСЛЕДНИЙ адрес).
# Только если backend стоит за доверенным прокси/ingress. По умолчанию false.
TRUST_PROXY_HEADERS=false

# --- ИИ (текстовый провайдер, OpenAI-совместимый API) ---
# Разбор тренировок по мышцам (muscle_load_v1), генерация программ, ответы в дневнике.
# Пустой AI_API_KEY = ИИ выключен: тренировки разбирает детерминированный движок
# правил (backend/muscle_engine.py), карта мышц и подсветка работают.
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek/deepseek-v4.1-flash-1017"
# Разбор мышц: none = без «размышлений» (~5 c вместо ~17 c), default = как настроено провайдером
AI_MUSCLE_REASONING="none"
# Vision-провайдер (разбор фото программ). Пусто = функция выключена.
AI_VISION_BASE_URL=""
AI_VISION_API_KEY=""
AI_VISION_MODEL="gemini-flash-latest"
